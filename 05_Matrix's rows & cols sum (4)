#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int randomN(int from, int to)
{
	return from + (rand() % (to - from + 1));
}

void rand3By3Matrix(int matrix[3][3])
{
	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
			matrix[r][c] = randomN(1, 100);
	}
}

void print3By3matrix(int matrix[3][3])
{
	cout << "\nThe following is a random " << "3*3" << " matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			cout << setw(3) << matrix[r][c] << "\t";
		}
		cout << "\n";
	}
}


void matrixRowsOrColsSums(int matrix[3][3], int sums[3], bool isRowSums = 1)
{
	unsigned short i = 0, j = 0;
	for (i = 0; i <= 2; ++i)
	{
		sums[i] = 0;
		for (j = 0; j <= 2; ++j)
		{
			sums[i] += ((isRowSums) ? matrix[i][j] : matrix[j][i]);
		}
	}
}

void printMatrixRowsOrColsSums(int sums[3], bool isRowSums = 1)
{
	cout << "\nThe following are the sums of each " << ((isRowSums) ?"row" :"column") << " in the matrix : \n";
	for (int i = 0; i < 3; ++i)
		cout << ((isRowSums) ? "Row" : "Column") <<" " << (i+1) << " sum: " << sums[i] << "\n";
}

int main()
{
	srand(time(0));

	int matrix[3][3];

	rand3By3Matrix(matrix);
	print3By3matrix(matrix);

	int sums[3];

  // Rows sum
	matrixRowsOrColsSums(matrix, sums);
	printMatrixRowsOrColsSums(sums);

  // Columns sum
	matrixRowsOrColsSums(matrix, sums, 0);
	printMatrixRowsOrColsSums(sums, 0);

	return 0;
}
