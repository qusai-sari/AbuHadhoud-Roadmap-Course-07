#include <iostream>
#include <cctype>
#include <string>
using namespace std;

string readTxt(string message)
{
	string s;
	cout << "\n" << message;
	getline(cin, s);

	return s;
}

void printFirstChars(string s)
{
	if (s[0] != ' ')
		cout << s[0] << "\n";

	unsigned strLen = s.length();
	for (int i = 0; i < strLen; ++i)
	{
		if (s[i] == ' ' && (i + 1) < strLen)
			cout << s[i + 1] << "\n";
	}
}

int main()
{
	string txt = readTxt("Enter your text: ");

	cout << "\nThose are the first characters of each word:\n";
	printFirstChars(txt);
	return 0;
}