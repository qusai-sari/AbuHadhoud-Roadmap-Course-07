string readTxt(string message, bool isLine = 0) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

unsigned short countChInTxt(const string& txt, char requiredCh, bool isCaseSensitive = 1)
{
	unsigned short counter = 0;

	if (!isCaseSensitive)
		requiredCh = tolower(requiredCh);

	for (const char& ch : txt)
	{
		counter += (isCaseSensitive) ? (ch == requiredCh ? 1 : 0) : (tolower(ch) == requiredCh ? 1 : 0);
	}

	return counter;
}

