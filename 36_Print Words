#include <iostream>
#include <string>
#include <cctype>

using namespace std;

string readTxt(string message, bool isLine = 0) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

void printWords(const string& s)
{
	cout << "\n";
	for (const char& ch : s)
	{
		if (ch == ' ')
			cout << "\n";
		cout << ch;
	}
}

int main()
{
	string s = readTxt("Enter a text: ");

	cout << "\n\nWords are: ";
	printWords(s);
	return 0;
}
