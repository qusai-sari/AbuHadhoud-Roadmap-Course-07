#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int randomN(int from, int to)
{
	return from + (rand() % (to - from + 1));
}

void rand3By3Matrix(int matrix[3][3])
{
	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
			matrix[r][c] = randomN(1, 10);
	}
}

void productOf2Matrixes(int matrix1[3][3], int marix2[3][3], int matrixMultiplication[3][3])
{
	for (int r = 0; r < 3; ++r)
	{
		for (int c = 0; c < 3; ++c)
		{
			matrixMultiplication[r][c] = matrix1[r][c] * marix2[r][c];
		}
	}
}

void print3By3matrix(int matrix[3][3], string matrixType)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%02d", matrix[r][c]);
			cout << "\t";
		}
		cout << "\n";
	}
}

int main()
{
	srand(time(0));

	int matrix1[3][3];
	int matrix2[3][3];
	int matrixMultiplication[3][3];

	rand3By3Matrix(matrix1);
	print3By3matrix(matrix1, "the first");

	cout << "\n\n";

	rand3By3Matrix(matrix2);
	print3By3matrix(matrix2, "the second");

	cout << "\n\n";

	productOf2Matrixes(matrix1, matrix2, matrixMultiplication);
	print3By3matrix(matrixMultiplication, "the result");

	return 0;
}
