#include <iostream>
#include <string>
using namespace std;

string readTxt(string message)
{
	string s;

	cout << "\n" << message;

	getline(cin, s);

	return s;
}

void lowerFirstChars(string* s)
{
	bool isCatch = 1;
	for (int i = 0; i < s->length(); ++i)
	{
		if (isCatch)
		{
			if ((int)s->at(i) <= 91 && (int)s->at(i) >= 65)
				s->at(i) += 32;
			isCatch = 0;
		}
		if (s->at(i) == ' ')
			isCatch = 1;
	}
}

int main()
{
	string txt = readTxt("Enter your text: ");
	string* ptr = &txt;

	lowerFirstChars(ptr);
	cout << "\nYour text after conversion:\n" << txt;
	return 0;
}
