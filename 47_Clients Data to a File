#include <iostream>
#include <string>
#include <vector>
#include <fstream>

using namespace std;


string readTxt(string message) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

struct stClientD
{
	string AccountId, pin, name, phone;
	double accountBalance;
};

stClientD newClient()
{
	stClientD clientD;
	cout << "\nNew client's field: \n\n";
	clientD.AccountId = readTxt("Enter your ID: ");
	clientD.pin = readTxt("Enter pin: ");
	clientD.name = readTxt("Enter your name: ");
	clientD.phone = readTxt("Enter your phone number: ");
	cout << "\nEnter your balance: ";
	cin >> clientD.accountBalance;

	return clientD;
}

string clientRecordToLine(stClientD& clientD, string sepa)
{
	return clientD.AccountId + sepa + clientD.pin + sepa + clientD.name + sepa + clientD.phone + sepa + to_string(clientD.accountBalance);
}

stClientD clientLineToRecord(string ClientDInLine, string sepa)
{
	stClientD clientD;

	clientD.AccountId = ClientDInLine.substr(0, ClientDInLine.find(sepa));
	ClientDInLine = ClientDInLine.substr(ClientDInLine.find(sepa) + sepa.length());

	clientD.pin = ClientDInLine.substr(0, ClientDInLine.find(sepa));
	ClientDInLine = ClientDInLine.substr(ClientDInLine.find(sepa) + sepa.length());

	clientD.name = ClientDInLine.substr(0, ClientDInLine.find(sepa));
	ClientDInLine = ClientDInLine.substr(ClientDInLine.find(sepa) + sepa.length());

	clientD.phone = ClientDInLine.substr(0, ClientDInLine.find(sepa));
	ClientDInLine = ClientDInLine.substr(ClientDInLine.find(sepa) + sepa.length());

	clientD.accountBalance = stod(ClientDInLine);

	return clientD;
}

void saveDataInFile(string ClientDInLine, string fileName)
{
	fstream file;

  file.open(fileName, ios::app | ios::out);

	if (file.is_open())
	{
		file << ClientDInLine << "\n";
		file.close();
	}
	else
		cout << "\n\nFile opening faild\n\n";
}

void printClientD(const stClientD& clientD)
{
	cout << "\nID             : " << clientD.AccountId << "\n";
	cout << "Pin            : " << clientD.pin << "\n";
	cout << "Name           : " << clientD.name << "\n";
	cout << "Phone number   : " << clientD.phone << "\n";
	cout << "Account Balance: " << clientD.accountBalance << "\n";
}

int main()
{
	stClientD clientD;
	string ClientDInLine;
	bool isCon = 1;
	while (isCon)
	{
		cout << "\n";
		clientD = newClient();
		ClientDInLine = clientRecordToLine(clientD, "//");
		saveDataInFile(ClientDInLine, "clients.txt");

		cout << "\nData saved successfully, Do you want to add another client(Yes = 1, No = 0): ";
		cin >> isCon;
		cin.ignore();
	}
	
	return 0;
}
