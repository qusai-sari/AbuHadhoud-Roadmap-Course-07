#include <iostream>
#include <cctype>
#include <string>
using namespace std;

string readTxt(string message)
{
	string s;

	cout << "\n" << message;

	getline(cin, s);

	return s;
}

void upperLetters(string& s)
{
	for (char& ch : s)
	{
		ch = toupper(ch);
	}
}

void lowerLetters(string* s)
{
	for (int i = 0; i < s->length(); ++i)
	{

		if ((int)s->at(i) <= 91 && (int)s->at(i) >= 65)
			s->at(i) += 32;
	}
}

int main()
{
	string txt = readTxt("Enter your text: ");
	string* ptr = &txt;

	upperLetters(txt);
	cout << "\nYour text in upper case:\n" << txt;
		
	lowerLetters(ptr);
	cout << "\nYour text in lower case:\n" << txt;
	return 0;
}
