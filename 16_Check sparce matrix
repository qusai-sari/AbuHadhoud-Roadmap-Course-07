#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

bool isMatrixSparce(int matrix[3][3])
{
	unsigned short zerosCounter = 0;
	for (int r = 0; r < 3; ++r)
	{
		for (int c = 0; c < 3; ++c)
		{
			if (matrix[r][c] == 0)
			{
				++zerosCounter;
			}
		}
	}
	return (zerosCounter > 4);
}

void print3By3matrix(int matrix[3][3], string matrixType, unsigned short numLength = 2)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%0*d\t", numLength, matrix[r][c]);
		}
		cout << "\n";
	}
}


int main()
{
	srand(time(0));

	int matrix[3][3] =
	{
		{9, 1, 12},
		{0, 9, 0},
		{0, 0, 0}
	};

	print3By3matrix(matrix, "a", 1);

	cout << "\n\nThe matrix is" << (isMatrixSparce(matrix) ? "" : "n't") << " sparce.";
	
	return 0;
}
