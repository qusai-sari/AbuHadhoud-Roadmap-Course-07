#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

bool isPalindromMatrix(int matrix[3][3])
{
	for (int r = 0; r < 3; ++r)
	{
		if (matrix[r][0] != matrix[r][2])
		{
			return 0;
		}
	}
	return 1;
}

void print3By3matrix(int matrix[3][3], string matrixType, unsigned short numLength = 2)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%0*d\t", numLength, matrix[r][c]);
		}
		cout << "\n";
	}
}

int main()
{
	srand(time(0));

	int matrix[3][3] =
	{
		{9, 1, 9},
		{0, 9, 0},
		{8, 0, 8}
	};


	print3By3matrix(matrix, "a", 1);


	cout << "\n\nThe number is" << (isPalindromMatrix(matrix) ? "" : "n't") << " palindrom.";
	
	return 0;
}
