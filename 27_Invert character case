#include <iostream>

using namespace std;

char invertChar(char ch)
{
	if ((int)ch >= 65 && (int)ch <= 91)
		return char((int)ch + 32);
	else if ((int)ch >= 97 && (int)ch <= 123)
		return char((int)ch - 32);

	return ch;
}

int main()
{
	char ch;
	cout << "Enter a character to invert: ";
	cin >> ch;

	cout << "\nYour inverted character:\n" << invertChar(ch);
	
	return 0;
}
