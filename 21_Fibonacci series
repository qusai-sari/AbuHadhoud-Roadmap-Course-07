#include <iostream>
using namespace std;

void printFibonacciNums(int num)
{
	int pre = 0, now = 1, temp;
	
	cout << "Those are a series of (" << num << ") fibonacci numbers : ";
	for (int i = 1; i <= num; ++i)
	{
		cout << now << "  ";
		temp = now;
		now += pre;
		pre = temp;
	}
}

int main()
{
	printFibonacciNums(10);
	return 0;
}
