#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

bool isNumFound(int matrix[3][3], int num)
{
	for (int r = 0; r < 3; ++r)
	{
		for (int c = 0; c < 3; ++c)
		{
			if (matrix[r][c] == num)
			{
				return 1;
			}
		}
	}
	return 0;
}

void print3By3matrix(int matrix[3][3], string matrixType, unsigned short numLength = 2)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%0*d\t", numLength, matrix[r][c]);
		}
		cout << "\n";
	}
}

void printIntersectedNums(int matrix1[3][3], int matrix2[3][3])
{

	cout << "\nThe numbers in 1st matrix found in 2nd matrix are: ";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			if (isNumFound(matrix2, matrix1[r][c]))
				cout << matrix1[r][c] << "\t";
		}

	}
}

int main()
{
	srand(time(0));

	int matrix1[3][3] =
	{
		{9, 1, 12},
		{0, 9, 0},
		{0, 0, 0}
	};

	int matrix2[3][3] =
	{
		{9, 1, 7},
		{2, 3, 0},
		{0, 4, 7}
	};

	print3By3matrix(matrix1, "the first", 1);
	print3By3matrix(matrix2, "the second", 1);


	printIntersectedNums(matrix1, matrix2);
	//cout << "\n\nThe number is" << (isNumFound(matrix, num) ? "" : "n't") << " found.";
	
	return 0;
}
