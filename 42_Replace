#include <vector>

using namespace std;

string readTxt(string message) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

string replaceWord(string str, string word, string replaceTo)
{
	int pos;
	while ((pos = str.find(word)) != std::string::npos)
	{
		str = str.substr(0, pos) + replaceTo + str.substr(pos + word.length());
	}

	return str;
}

int main()
{
	string txt = "Qusai, Be a real Muslim, be an effective Muslim, who worships god in every dead in thier life. Qusai by the willingness of god you can do it.";
	
	cout << "The original text:\n" << txt << "\n\n";

	cout << "Text after word replacement:\n" << replaceWord(txt, "god", "Allah");
	
	return 0;
}
