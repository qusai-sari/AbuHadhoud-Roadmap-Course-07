string readTxt(string message, bool isLine = 0) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

unsigned short countChInTxt(const string& txt, const char& requiredCh)
{
	unsigned short counter = 0;

	for (const char& ch : txt)
	{
		counter += ch == requiredCh ? 1 : 0;
	}

	return counter;
}

