#include <iostream>
#include <string>

using namespace std;

string readTxt(string message) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

string trimR(string s)
{
	unsigned count = 0;
	if (s.length() > 0)
		for (int i = s.length() - 1; i >= 0; --i)
			if (s[i] == ' ') ++count;
			else break;

	s = s.erase(s.length() - count, count);

	return s;
}

string trimL(string s)
{
	unsigned count = 0;
	for (char& ch : s)
		if (ch == ' ') ++count;
		else break;

	s = s.erase(0, count);
	return s;
}

string trim(string s, string side = "both")
{
	unsigned count = 0;
	if (side == "right" || side == "both")
		s = trimR(s);

	if (side == "left" || side == "both")
		s = trimL(s);

	return s;
}

int main()
{
	string s = readTxt("Enter a text: ");
	string side = readTxt("Enter the side of trimming (right, left, both): ");

	s = trim(s, side);
	cout << "\n\nYour text after trimming: (" << s << ")";
	return 0;
}