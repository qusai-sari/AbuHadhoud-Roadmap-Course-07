#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int readInt(string message, bool isPos = 1)
{
	int num;
	cout << "\n" << message;

	do
	{
		cin >> num;
		if (isPos && num < 0)
		{
			cout << "\nPositive number: ";
		}
		else if (!isPos && num > 0)
		{
			cout << "\Nigative number: ";
		}
		else if (cin.fail())
		{
			cin.clear();
			cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
			cout << "\nInvalid value: ";
		}
		else
			break;
	} while (true);

	return num;
}

bool isNumFound(int matrix[3][3], int num)
{
	for (int r = 0; r < 3; ++r)
	{
		for (int c = 0; c < 3; ++c)
		{
			if (matrix[r][c] == num)
			{
				return 1;
			}
		}
	}
	return 0;
}

void print3By3matrix(int matrix[3][3], string matrixType, unsigned short numLength = 2)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%0*d\t", numLength, matrix[r][c]);
		}
		cout << "\n";
	}
}


int main()
{
	srand(time(0));

	int matrix[3][3] =
	{
		{9, 1, 12},
		{0, 9, 0},
		{0, 0, 0}
	};

	print3By3matrix(matrix, "a", 1);\

	int num = readInt("Enter the number you want to look for in the matrix: ");

	cout << "\n\nThe number is" << (isNumFound(matrix, num) ? "" : "n't") << " found.";
	
	return 0;
}
