#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int randomN(int from, int to)
{
	return from + (rand() % (to - from + 1));
}

void rand3By3Matrix(int matrix[3][3])
{
	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
			matrix[r][c] = randomN(1, 10);
	}
}

int sumOf3By3MatrixElements(int matrix[3][3])
{
	int sum = 0;
	for (int r = 0; r < 3; ++r)
	{
		for (int c = 0; c < 3; ++c)
			sum += matrix[r][c];
	}
	return sum;
}

void _2matrixes3by3Equality(int matrix1[3][3], int matrix2[3][3])
{
	cout << "\n\nThe matrixes are" << ((sumOf3By3MatrixElements(matrix1) != sumOf3By3MatrixElements(matrix2))? "n't" : "") << " equal.";;
}

void print3By3matrix(int matrix[3][3], string matrixType)
{
	cout << "\nThe following is " << matrixType << " 3*3 " << "matrix:\n";

	for (unsigned short r = 0; r <= 2; ++r)
	{
		for (unsigned short c = 0; c <= 2; ++c)
		{
			printf("%02d\t", matrix[r][c]);
		}
		cout << "\n";
	}
}


int main()
{
	srand(time(0));

	int matrix1[3][3];
	int matrix2[3][3];

	rand3By3Matrix(matrix1);
	print3By3matrix(matrix1, "the first");

	cout << "\n\n";

	rand3By3Matrix(matrix2);
	print3By3matrix(matrix2, "the second");

	cout << "\n\n";

	_2matrixes3by3Equality(matrix1, matrix2);
	
	return 0;
}
