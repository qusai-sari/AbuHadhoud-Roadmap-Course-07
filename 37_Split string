#include <iostream>
#include <string>
#include <cctype>
#include <vector>

using namespace std;

string readTxt(string message, bool isLine = 0) {
	string in;
	cout << "\n" << message;
	getline(cin, in);
	return in;
}

vector<string> splitString(string s, string delim = " ")
{
	int pos = 0;
	vector<string> vec;
	string word;

	while ((pos = s.find(delim)) != std::string::npos)
	{
		word = s.substr(0, pos);

		if (word != "")
			vec.push_back(word);

		s.erase(0, pos + delim.length());
	}

	if (s != "")
		vec.push_back(s);

	return vec;
}

void printVec(const vector<string>& vec)
{
	cout << "\n";
	for (const string& s : vec)
		cout << s << "\n";
}

int main()
{
	string s = readTxt("Enter a text: ");
	vector<string> vec = splitString(s);

	cout << "\n\nTokens: " << vec.size();

	printVec(vec);
	return 0;
}
